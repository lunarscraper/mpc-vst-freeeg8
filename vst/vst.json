{
  "name": "Free EQ8",
  "vendor": "lunarscraper",
  "uid": "FEq8",
  "version": 1000,
  "targets": [
    "armv7",
    "aarch64"
  ],
  "so": "freeeq8.so",
  "effect": true,
  "params": "params.json",
  "layout": "layout.conf",
  "presets": "presets.json",
  "build": {
    "root": "..",
